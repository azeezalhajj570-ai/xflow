# =============================================================================
# Odoo 19 Development Environment - Example Configuration
# =============================================================================
# Copy this file to .env and customize:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=ChangeMe123!
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Odoo ---
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
ODOO_ADMIN_PASSWD=admin
ODOO_DATABASE=odoo
ODOO_DBFILTER=.*
ODOO_WORKERS=4
ODOO_PROXY_MODE=True

# --- Container resource limits ---
DB_MEMORY_LIMIT=1G
ODOO_MEMORY_LIMIT=3G

# --- Docker ---
COMPOSE_PROJECT_NAME=odoo19-dev
NETWORK_NAME=odoo19-dev-network

# --- Timezone ---
TZ=UTC
