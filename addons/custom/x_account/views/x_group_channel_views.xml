<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_group_channel_view_tree" model="ir.ui.view">
        <field name="name">x.group.channel.view.tree</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list string="Chat" create="false" delete="false">
                <field name="name"/>
                <field name="channel_type" string="Type"/>
                <field name="x_conversation_id" string="Conversation ID"/>
                <field name="x_account_id"/>
                <field name="x_group_member_count" string="Members"/>
            </list>
        </field>
    </record>

    <record id="x_group_channel_view_form" model="ir.ui.view">
        <field name="name">x.group.channel.view.form</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <form string="Chat" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Chat name (editable)"/></h1>
                    </div>
                    <group>
                        <field name="channel_type" string="Type" readonly="1"/>
                        <field name="x_conversation_id" string="Conversation ID" readonly="1"/>
                        <field name="x_account_id" string="X Account" readonly="1"/>
                        <field name="x_group_member_count" string="Members" readonly="1"
                            invisible="channel_type != 'x_group'"/>
                    </group>
                    <group string="Members" invisible="channel_type != 'x_group'">
                        <field name="x_group_member_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="name" string="Member Name"/>
                                <field name="x_username" string="Username"/>
                                <field name="x_is_verified" string="Verified"/>
                                <field name="x_is_blue_verified" string="Blue Verified"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_x_account_group_channels" model="ir.actions.act_window">
        <field name="name">Chat</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('channel_type', 'in', ['x', 'x_group'])]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('x_group_channel_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('x_group_channel_view_form')})]"/>
    </record>
</odoo>
