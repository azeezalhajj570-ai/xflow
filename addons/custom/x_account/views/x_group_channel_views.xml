<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_group_channel_view_tree" model="ir.ui.view">
        <field name="name">x.group.channel.view.tree</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list string="Chat" create="false" delete="false">
                <field name="name"/>
                <field name="channel_type" string="Type"/>
                <field name="x_conversation_id" string="Conversation ID"/>
                <field name="x_account_id"/>
                <field name="x_group_member_count" string="Members"/>
            </list>
        </field>
    </record>

    <record id="x_group_channel_view_form" model="ir.ui.view">
        <field name="name">x.group.channel.view.form</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <form string="Chat" create="false">
                <header>
                    <button name="%(x_account.action_server_bulk_follow)d" type="action"
                        string="Follow Members" class="btn-secondary"
                        invisible="channel_type != 'x_group'"
                        groups="social.group_social_user"/>
                    <button name="%(x_account.action_server_send_message)d" type="action"
                        string="Send Message" class="btn-primary"
                        groups="social.group_social_user"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Chat name (editable)"/></h1>
                    </div>
                    <notebook>
                        <page string="Information" name="information">
                            <group>
                                <field name="channel_type" string="Type" readonly="1"/>
                                <field name="x_conversation_id" string="Conversation ID" readonly="1"/>
                                <field name="x_account_id" string="X Account" readonly="1"/>
                                <field name="x_group_member_count" string="Members" readonly="1"
                                    invisible="channel_type != 'x_group'"/>
                            </group>
                        </page>
                        <page string="Members" name="members"
                            invisible="channel_type not in ('x', 'x_group')">
                            <field name="channel_member_ids" mode="list"
                                context="{'active_test': False}"
                                readonly="channel_type != 'x_group'">
                                <list string="Members" editable="bottom">
                                    <field name="partner_id" string="Partner" required="1"/>
                                    <field name="x_partner_name" string="Member Name" readonly="1"/>
                                    <field name="x_partner_username" string="Username" readonly="1"/>
                                    <field name="x_partner_verified" string="Verified" readonly="1"/>
                                    <field name="x_partner_blue_verified" string="Blue Verified" readonly="1"/>
                                    <field name="x_partner_is_following" string="Following" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_discuss_channel_search_inherit_x_account" model="ir.ui.view">
        <field name="name">discuss.channel.search.inherit.x_account</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="x_conversation_id" string="X Conversation ID"/>
                <field name="x_account_id" string="X Account"/>
                <separator/>
                <filter string="X: 1:1" name="x_type_direct"
                    domain="[('channel_type', '=', 'x')]"/>
                <filter string="X: Groups" name="x_type_group"
                    domain="[('channel_type', '=', 'x_group')]"/>
                <separator/>
                <filter string="X: Synchronized" name="x_sync_ok"
                    domain="[('x_sync_status', '=', 'ok')]"/>
                <filter string="X: Encrypted" name="x_sync_encrypted"
                    domain="[('x_sync_status', '=', 'encrypted')]"/>
                <filter string="X: Partially Synchronized" name="x_sync_partial"
                    domain="[('x_sync_status', '=', 'partial')]"/>
                <filter string="X: Sync Failed" name="x_sync_failed"
                    domain="[('x_sync_status', '=', 'failed')]"/>
                <filter string="X: Missing Account" name="x_no_account"
                    domain="[('x_account_id', '=', False)]"/>
                <group>
                    <filter string="X Type" name="x_groupby_type" domain="[]"
                        context="{'group_by': 'channel_type'}"/>
                    <filter string="X Account" name="x_groupby_account" domain="[]"
                        context="{'group_by': 'x_account_id'}"/>
                    <filter string="X Sync Status" name="x_groupby_sync_status" domain="[]"
                        context="{'group_by': 'x_sync_status'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_x_account_group_channels" model="ir.actions.act_window">
        <field name="name">Chat</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('channel_type', 'in', ['x', 'x_group'])]</field>
        <field name="search_view_id" ref="mail.discuss_channel_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('x_group_channel_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('x_group_channel_view_form')})]"/>
    </record>
</odoo>
