<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_import_session_view_form" model="ir.ui.view">
        <field name="name">x.import.session.view.form</field>
        <field name="model">x.import.session</field>
        <field name="arch" type="xml">
            <form string="Link X Account">
                <group>
                    <field name="provider"/>
                    <field name="auth_token" password="True"/>
                </group>
                <footer>
                    <button name="action_import" string="Link Account" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_x_import_session" model="ir.actions.act_window">
        <field name="name">Link X Account</field>
        <field name="res_model">x.import.session</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
