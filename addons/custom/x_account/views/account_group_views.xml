<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_group_view_tree" model="ir.ui.view">
        <field name="name">x.account.group.view.tree</field>
        <field name="model">x.account.group</field>
        <field name="arch" type="xml">
            <list string="X Account Groups">
                <field name="name"/>
                <field name="account_ids" widget="many2many_tags"/>
                <field name="actions"/>
                <field name="auto_execute"/>
                <field name="paused"/>
            </list>
        </field>
    </record>

    <record id="x_account_group_view_form" model="ir.ui.view">
        <field name="name">x.account.group.view.form</field>
        <field name="model">x.account.group</field>
        <field name="arch" type="xml">
            <form string="X Account Group">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="actions"/>
                            <field name="auto_execute"/>
                            <field name="cooldown_sec"/>
                            <field name="paused"/>
                        </group>
                    </group>
                    <group string="X Accounts">
                        <field name="account_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="x_account_group_view_search" model="ir.ui.view">
        <field name="name">x.account.group.view.search</field>
        <field name="model">x.account.group</field>
        <field name="arch" type="xml">
            <search string="X Account Groups">
                <field name="name"/>
                <field name="description"/>
                <field name="account_ids"/>
                <filter string="Auto Execute" name="auto_execute" domain="[('auto_execute', '=', True)]"/>
                <filter string="Paused" name="paused" domain="[('paused', '=', True)]"/>
                <filter string="Running" name="running" domain="[('auto_execute', '=', True), ('paused', '=', False)]"/>
                <filter string="Has Accounts" name="has_accounts" domain="[('account_ids', '!=', False)]"/>
                <group>
                    <filter string="Automation Action" name="groupby_actions" domain="[]" context="{'group_by': 'actions'}"/>
                    <filter string="Auto Execute" name="groupby_auto_execute" domain="[]" context="{'group_by': 'auto_execute'}"/>
                    <filter string="Paused" name="groupby_paused" domain="[]" context="{'group_by': 'paused'}"/>
                    <filter string="Creation Date" name="groupby_create_date" domain="[]" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="x_account_group_view_kanban" model="ir.ui.view">
        <field name="name">x.account.group.view.kanban</field>
        <field name="model">x.account.group</field>
        <field name="arch" type="xml">
            <!-- Grouped by the automation action, so each column is one action
                 (Like, Repost, Bookmark, Comment, Follow). -->
            <kanban default_group_by="actions" class="o_kanban_small_column"
                records_draggable="true" on_create="quick_create">
                <field name="name"/>
                <field name="description"/>
                <field name="account_ids"/>
                <field name="actions"/>
                <field name="auto_execute"/>
                <field name="paused"/>
                <field name="cooldown_sec"/>
                <field name="last_executed_at"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable">
                            <a role="menuitem" type="open" class="dropdown-item">Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="description" class="text-muted"/>
                        <field name="account_ids" widget="many2many_tags"/>
                        <footer class="mt-2 mb-0 pt-0 d-flex align-items-center">
                            <field name="actions" widget="badge"/>
                            <field name="paused" widget="boolean_toggle"
                                invisible="not paused"/>
                            <field name="auto_execute" widget="boolean_toggle" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_x_account_group" model="ir.actions.act_window">
        <field name="name">X Account Groups</field>
        <field name="res_model">x.account.group</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
