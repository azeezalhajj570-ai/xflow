<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_base_automation_list_inherit" model="ir.ui.view">
        <field name="name">base.automation.list.inherit.x_account</field>
        <field name="model">base.automation</field>
        <field name="inherit_id" ref="base_automation.view_base_automation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="active" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="view_base_automation_search_inherit" model="ir.ui.view">
        <field name="name">base.automation.search.inherit.x_account</field>
        <field name="model">base.automation</field>
        <field name="inherit_id" ref="base_automation.view_base_automation_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
