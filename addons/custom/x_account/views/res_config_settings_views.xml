<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_x_account_settings" model="ir.actions.act_window">
        <field name="name">X Account Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'x_account', 'bin_size': False}</field>
    </record>

    <record id="x_account_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.x.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" id="x_account_settings_block"
                     data-string="X Account" string="X Account"
                     data-key="x_account" groups="base.group_system">
                    <h2>Authentication</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_auth_method"/>
                                <field name="x_auth_method"/>
                            </div>
                        </div>
                    </div>
                    <h2>Providers</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_provider"/>
                                <field name="x_provider"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_event_provider"/>
                                <field name="x_event_provider"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_action_provider"/>
                                <field name="x_action_provider"/>
                            </div>
                        </div>
                    </div>
                    <h2>Advanced</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_web_api_base"/>
                                <field name="x_web_api_base"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_encryption_key_configured"/>
                                <field name="x_encryption_key_configured"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
