<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_social_account_view_form" model="ir.ui.view">
        <field name="name">x.account.social.account.view.form</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="social.social_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_account_global']" position="after">
                <group name="x_account" string="X Account">
                    <group>
                        <field name="x_connection_status" widget="badge"
                            decoration-success="x_connection_status == 'active'"
                            decoration-warning="x_connection_status == 'reauth_required'"
                            decoration-danger="x_connection_status in ('disconnected', 'error', 'invalid')"/>
                        <field name="x_provider" invisible="1"/>
                        <field name="x_event_provider" invisible="1"/>
                        <field name="x_action_provider" invisible="1"/>
                        <field name="twitter_user_id" readonly="1"/>
                    </group>
                    <group string="X Chat Encryption" groups="social.group_social_user">
                        <field name="x_chat_key_mode" widget="radio"/>
                        <field name="x_encryption_code" password="True" placeholder="Your XChat PIN"
                            invisible="x_chat_key_mode != 'juicebox'"/>
                        <field name="x_chat_key_blob" widget="text"
                            invisible="x_chat_key_mode != 'key_blob'"/>
                        <field name="x_chat_initialized" readonly="1" widget="boolean_toggle"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="x_account_social_account_view_form_standalone" model="ir.ui.view">
        <field name="name">x.account.social.account.view.form.standalone</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <form string="X Account" create="false">
                <header>
                    <button name="action_initialize_x_chat_encryption" type="object"
                        string="Initialize Encryption"
                        class="btn-primary"
                        confirm="Initialize X Chat encryption using the configured key source?"
                        groups="social.group_social_user"/>
                    <button name="action_register_x_chat_public_keys" type="object"
                        string="Setup Chat Keys"
                        class="btn-primary"
                        confirm="Register a fresh X Chat identity? This is a one-time, rate-limited write that generates keys, registers them with X and backs them up (PIN mode)."
                        groups="social.group_social_user"
                        invisible="x_chat_initialized"/>
                    <button name="action_delete_x_subscriptions" type="object"
                        string="Delete X Subscriptions"
                        class="btn-secondary"
                        confirm="Delete all X Activity API subscriptions for this account?"
                        invisible="(not x_action_provider and not x_provider) or not twitter_user_id"/>
                    <button name="action_resubscribe_x_subscriptions" type="object"
                        string="Resubscribe"
                        invisible="(not x_action_provider and not x_provider) or not twitter_user_id"/>
                    <button name="action_sync_chat_names" type="object"
                        string="Sync Chat Names"
                        class="btn-secondary"
                        groups="social.group_social_user"
                        confirm="Sync chat names from GetXAPI into existing channels?"
                        invisible="(not x_action_provider and not x_provider) or not twitter_user_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Account name"/></h1>
                    </div>
                    <group>
                        <group string="Account Info">
                            <field name="social_account_handle" placeholder="@handle"/>
                            <field name="x_provider" invisible="1"/>
                            <field name="x_event_provider" invisible="1"/>
                            <field name="x_action_provider" invisible="1"/>
                            <field name="twitter_user_id" readonly="1"/>
                            <field name="x_connection_status" widget="badge"
                                decoration-success="x_connection_status == 'active'"
                                decoration-warning="x_connection_status == 'reauth_required'"
                                decoration-danger="x_connection_status in ('disconnected', 'error', 'invalid')"/>
                        </group>
                        <group string="X Chat Encryption" groups="social.group_social_user">
                            <field name="x_chat_key_mode" widget="radio"/>
                            <field name="x_encryption_code" password="True" placeholder="Your XChat PIN"
                                invisible="x_chat_key_mode != 'juicebox'"/>
                            <field name="x_chat_key_blob" widget="text" placeholder="Paste key blob here..."
                                invisible="x_chat_key_mode != 'key_blob'"/>
                            <field name="x_chat_signing_key_version" readonly="1"
                                invisible="not x_chat_signing_key_version"/>
                            <field name="x_chat_initialized" readonly="1" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="x_account_social_account_view_list" model="ir.ui.view">
        <field name="name">x.account.social.account.view.list</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <list string="X Accounts" create="false">
                <field name="name"/>
                <field name="social_account_handle"/>
                <field name="x_provider" column_invisible="1"/>
                <field name="x_connection_status"/>
                <!-- <field name="last_validated"/> -->
            </list>
        </field>
    </record>

    <record id="view_social_account_search_inherit_x_account" model="ir.ui.view">
        <field name="name">social.account.search.inherit.x_account</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="social.social_account_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="X: Active" name="x_connection_active"
                    domain="[('x_connection_status', '=', 'active')]"/>
                <filter string="X: Needs Reauthentication" name="x_connection_reauth"
                    domain="[('x_connection_status', '=', 'reauth_required')]"/>
                <filter string="X: Disconnected / Invalid" name="x_connection_broken"
                    domain="[('x_connection_status', 'in', ['disconnected', 'invalid', 'error'])]"/>
                <filter string="X: Disabled" name="x_connection_disabled"
                    domain="[('x_connection_status', '=', 'disabled')]"/>
                <filter string="X: Chat Not Initialized" name="x_chat_not_initialized"
                    domain="[('x_chat_initialized', '=', False)]"/>
                <filter string="X: PIN Rejected" name="x_chat_pin_locked"
                    domain="[('x_chat_pin_locked', '=', True)]"/>
                <group>
                    <filter string="X Connection Status" name="x_groupby_connection_status" domain="[]"
                        context="{'group_by': 'x_connection_status'}"/>
                    <filter string="X Chat Key Source" name="x_groupby_chat_key_mode" domain="[]"
                        context="{'group_by': 'x_chat_key_mode'}"/>
                    <filter string="X Chat Initialized" name="x_groupby_chat_initialized" domain="[]"
                        context="{'group_by': 'x_chat_initialized'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_x_account_social_accounts" model="ir.actions.act_window">
        <field name="name">X Accounts</field>
        <field name="res_model">social.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('media_type', '=', 'twitter')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('x_account_social_account_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('x_account_social_account_view_form_standalone')})]"/>
    </record>
</odoo>
