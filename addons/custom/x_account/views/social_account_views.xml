<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_social_account_view_form" model="ir.ui.view">
        <field name="name">x.account.social.account.view.form</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="social.social_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_account_global']" position="after">
                <group name="x_account" string="X Account">
                    <group>
                        <field name="x_connection_status" widget="badge"
                            decoration-success="x_connection_status == 'active'"
                            decoration-warning="x_connection_status == 'reauth_required'"
                            decoration-danger="x_connection_status in ('disconnected', 'error', 'invalid')"/>
                        <field name="x_provider"/>
                        <field name="twitter_user_id" readonly="1"/>
                    </group>
                    <group string="X Chat Encryption" groups="base.group_system">
                        <field name="x_chat_key_mode" widget="radio"/>
                        <field name="x_encryption_code" password="True" placeholder="Your XChat PIN"
                            invisible="x_chat_key_mode != 'juicebox'"/>
                        <field name="x_chat_key_blob" widget="text"
                            invisible="x_chat_key_mode != 'key_blob'"/>
                        <field name="x_chat_initialized" readonly="1" widget="boolean_toggle"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="x_account_social_account_view_form_standalone" model="ir.ui.view">
        <field name="name">x.account.social.account.view.form.standalone</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <form string="X Account">
                <header>
                    <button name="action_initialize_x_chat_encryption" type="object"
                        string="Initialize Encryption"
                        class="btn-primary"
                        confirm="Initialize X Chat encryption using the configured key source?"
                        groups="base.group_system"
                        invisible="x_connection_status not in ('active', 'reauth_required', 'error')"/>
                    <button name="action_delete_x_subscriptions" type="object"
                        string="Delete X Subscriptions"
                        class="btn-secondary"
                        confirm="Delete all X Activity API subscriptions for this account?"
                        invisible="x_provider != 'twitter' or not twitter_user_id"/>
                    <button name="action_resubscribe_x_subscriptions" type="object"
                        string="Resubscribe"
                        class="btn-secondary"
                        invisible="x_provider != 'twitter' or not twitter_user_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Account name"/></h1>
                    </div>
                    <group>
                        <group string="Account Info">
                            <field name="social_account_handle" placeholder="@handle"/>
                            <field name="x_provider"/>
                            <field name="twitter_user_id" readonly="1"/>
                            <field name="x_connection_status" widget="badge"
                                decoration-success="x_connection_status == 'active'"
                                decoration-warning="x_connection_status == 'reauth_required'"
                                decoration-danger="x_connection_status in ('disconnected', 'error', 'invalid')"/>
                        </group>
                        <group string="X Chat Encryption" groups="base.group_system">
                            <field name="x_chat_key_mode" widget="radio"/>
                            <field name="x_encryption_code" password="True" placeholder="Your XChat PIN"
                                invisible="x_chat_key_mode != 'juicebox'"/>
                            <field name="x_chat_key_blob" widget="text" placeholder="Paste key blob here..."
                                invisible="x_chat_key_mode != 'key_blob'"/>
                            <field name="x_chat_signing_key_version" readonly="1"
                                invisible="not x_chat_signing_key_version"/>
                            <field name="x_chat_initialized" readonly="1" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="x_account_social_account_view_list" model="ir.ui.view">
        <field name="name">x.account.social.account.view.list</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <list string="X Accounts" create="false">
                <field name="name"/>
                <field name="social_account_handle"/>
                <field name="x_provider"/>
                <field name="x_connection_status"/>
                <!-- <field name="last_validated"/> -->
            </list>
        </field>
    </record>

    <record id="action_x_account_social_accounts" model="ir.actions.act_window">
        <field name="name">X Accounts</field>
        <field name="res_model">social.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('media_type', '=', 'twitter'), ('x_provider', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('x_account_social_account_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('x_account_social_account_view_form_standalone')})]"/>
    </record>
</odoo>
