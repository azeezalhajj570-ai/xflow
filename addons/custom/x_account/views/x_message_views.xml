<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_message_view_list" model="ir.ui.view">
        <field name="name">x.message.view.list</field>
        <field name="model">x.message</field>
        <field name="arch" type="xml">
            <list string="X Messages" create="false" delete="false" edit="false">
                <field name="direction"/>
                <field name="channel_id"/>
                <field name="account_id"/>
                <field name="author_partner_id"/>
                <field name="body_plain"/>
                <field name="external_created_at"/>
            </list>
        </field>
    </record>

    <record id="x_message_view_form" model="ir.ui.view">
        <field name="name">x.message.view.form</field>
        <field name="model">x.message</field>
        <field name="arch" type="xml">
            <form string="X Message" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="direction"/>
                        <field name="channel_id"/>
                        <field name="account_id"/>
                        <field name="author_partner_id"/>
                        <field name="author_x_id"/>
                        <field name="author_x_username"/>
                        <field name="external_id"/>
                        <field name="external_created_at"/>
                    </group>
                    <group string="Message">
                        <field name="body_plain" readonly="1"/>
                    </group>
                    <group string="Delivery">
                        <field name="acked"/>
                        <field name="delivered"/>
                        <field name="participant_joined"/>
                        <field name="participant_left"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="x_message_view_search" model="ir.ui.view">
        <field name="name">x.message.view.search</field>
        <field name="model">x.message</field>
        <field name="arch" type="xml">
            <search string="X Messages">
                <field name="body_plain" string="Body"/>
                <field name="external_id"/>
                <field name="author_x_username"/>
                <field name="author_partner_id"/>
                <field name="channel_id"/>
                <field name="account_id"/>
                <filter string="Incoming" name="direction_inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter string="Outgoing" name="direction_outbound" domain="[('direction', '=', 'outbound')]"/>
                <separator/>
                <filter string="Acknowledged" name="acked" domain="[('acked', '=', True)]"/>
                <filter string="Delivered" name="delivered" domain="[('delivered', '=', True)]"/>
                <filter string="Participant Joined" name="participant_joined" domain="[('participant_joined', '=', True)]"/>
                <filter string="Participant Left" name="participant_left" domain="[('participant_left', '=', True)]"/>
                <separator/>
                <filter string="Received" name="filter_external_created_at" date="external_created_at"/>
                <separator/>
                <group>
                    <filter string="Direction" name="groupby_direction" domain="[]" context="{'group_by': 'direction'}"/>
                    <filter string="X Account" name="groupby_account" domain="[]" context="{'group_by': 'account_id'}"/>
                    <filter string="Chat" name="groupby_channel" domain="[]" context="{'group_by': 'channel_id'}"/>
                    <filter string="Author" name="groupby_author" domain="[]" context="{'group_by': 'author_partner_id'}"/>
                    <filter string="Company" name="groupby_company" domain="[]" context="{'group_by': 'company_id'}"/>
                    <filter string="Creation Date" name="groupby_create_date" domain="[]" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_x_account_messages" model="ir.actions.act_window">
        <field name="name">X Messages</field>
        <field name="res_model">x.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_groupby_channel': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('x_message_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('x_message_view_form')})]"/>
    </record>
</odoo>
