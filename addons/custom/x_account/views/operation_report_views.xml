<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_operation_report_view_list" model="ir.ui.view">
        <field name="name">x.account.operation.report.view.list</field>
        <field name="model">x.account.operation.report</field>
        <field name="arch" type="xml">
            <list string="X Operations" create="false" edit="false" delete="false" default_order="received_at desc">
                <field name="create_date" optional="hide"/>
                <field name="received_at" widget="relative"/>
                <field name="channel_link" string="Chat" widget="html"/>
                <field name="channel_id" optional="hide"/>
                <field name="account_id"/>
                <field name="operation" widget="badge"/>
                <field name="author_link" string="Author" widget="html"/>
                <field name="tweet_url" widget="url" string="Tweet"/>
                <field name="tweet_screen_name" optional="hide"/>
                <field name="author_x_id" optional="hide"/>
                <field name="tweet_id" optional="hide"/>
                <field name="status" optional="show"/>
                <field name="done_at" widget="relative" optional="show"/>
                <field name="processing_time" widget="float_time" optional="show"/>
                <field name="source" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="x_account_operation_report_view_pivot" model="ir.ui.view">
        <field name="name">x.account.operation.report.view.pivot</field>
        <field name="model">x.account.operation.report</field>
        <field name="arch" type="xml">
            <pivot string="X Operations">
                <field name="account_id" type="row"/>
                <field name="channel_id" type="row" optional="hide"/>
                <field name="tweet_id" type="row" optional="hide"/>
                <field name="operation" type="col"/>
                <field name="status" type="col" optional="hide"/>
                <field name="operation_count" type="measure"/>
                <field name="processing_time" type="measure" optional="show"/>
            </pivot>
        </field>
    </record>

    <record id="x_account_operation_report_view_graph" model="ir.ui.view">
        <field name="name">x.account.operation.report.view.graph</field>
        <field name="model">x.account.operation.report</field>
        <field name="arch" type="xml">
            <graph string="X Operations" type="bar">
                <field name="account_id"/>
                <field name="channel_id" optional="hide"/>
                <field name="operation"/>
                <field name="operation_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="x_account_operation_report_view_search" model="ir.ui.view">
        <field name="name">x.account.operation.report.view.search</field>
        <field name="model">x.account.operation.report</field>
        <field name="arch" type="xml">
            <search string="X Operations">
                <field name="channel_id"/>
                <field name="account_id"/>
                <field name="tweet_id"/>
                <field name="tweet_screen_name"/>
                <field name="author_x_id"/>
                <field name="received_at"/>
                <field name="done_at"/>
                <filter string="Like" name="op_like" domain="[('operation', '=', 'like')]"/>
                <filter string="Repost" name="op_repost" domain="[('operation', '=', 'repost')]"/>
                <filter string="Bookmark" name="op_bookmark" domain="[('operation', '=', 'bookmark')]"/>
                <filter string="Comment" name="op_comment" domain="[('operation', '=', 'comment')]"/>
                <separator/>
                <filter string="Success" name="status_success" domain="[('status', '=', 'success')]"/>
                <filter string="Failed" name="status_failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Pending" name="status_pending" domain="[('status', '=', 'pending')]"/>
                <separator/>
                <filter string="Created On" name="filter_create_date" date="create_date"/>
                <filter string="Done On" name="filter_done_at" date="done_at"/>
                <separator/>
                <group>
                    <filter string="X Account" name="groupby_account" domain="[]" context="{'group_by': 'account_id'}"/>
                    <filter string="Chat" name="groupby_channel" domain="[]" context="{'group_by': 'channel_id'}"/>
                    <filter string="Tweet" name="groupby_tweet" domain="[]" context="{'group_by': 'tweet_id'}"/>
                    <filter string="Operation" name="groupby_operation" domain="[]" context="{'group_by': 'operation'}"/>
                    <filter string="Status" name="groupby_status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Source" name="groupby_source" domain="[]" context="{'group_by': 'source'}"/>
                    <filter string="Company" name="groupby_company" domain="[]" context="{'group_by': 'company_id'}"/>
                    <filter string="Created Date" name="groupby_create_date" domain="[]" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Created Month" name="groupby_create_month" domain="[]" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_x_account_operation_report" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">x.account.operation.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_groupby_account': 1, 'search_default_groupby_channel': 2, 'search_default_groupby_operation': 3}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No X operations recorded yet.</p>
            <p>
                Likes, reposts, bookmarks and comments performed by X accounts are
                listed here, grouped by discuss channel, account and tweet.
            </p>
        </field>
    </record>
</odoo>
