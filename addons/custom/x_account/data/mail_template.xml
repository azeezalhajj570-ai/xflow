<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mail_template_x_account_reauth_required" model="mail.template">
        <field name="name">X Account: Reauthentication Required</field>
        <field name="model_id" ref="social.model_social_account"/>
        <field name="subject">X account requires reauthentication: {{ object.name }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px;">
                    <span>This X account requires reauthentication. Open it and
                        complete the OAuth 2.0 flow before its automation
                        (webhooks, likes, reposts, DMs...) can run again.
                    </span>
                </p>
                <p style="margin: 8px 0px 0px 0px;">
                    <span>Account: <b t-out="object.name"/><br/>
                        Reason: <t t-out="object.last_error"/>
                    </span>
                </p>
            </div>
        </field>
    </record>

    <record id="mail_template_x_account_decrypt_stopped" model="mail.template">
        <field name="name">X Account: Chat Decryption Stopped</field>
        <field name="model_id" ref="social.model_social_account"/>
        <field name="subject">X account stopped decrypting incoming messages: {{ object.name }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px;">
                    <span>This X account is receiving encrypted chats but can no
                        longer decrypt them, so no new message is being stored
                        in its conversations. Re-run the encryption key setup on
                        the account (or fix its PIN / imported key blob) to
                        resume.
                    </span>
                </p>
                <p style="margin: 8px 0px 0px 0px;">
                    <span>Account: <b t-out="object.name"/><br/>
                        Key source: <t t-out="object.x_chat_key_mode"/><br/>
                        Unread deliveries: <t t-out="object.x_chat_decrypt_fail_streak"/>
                    </span>
                </p>
            </div>
        </field>
    </record>
    <record id="mail_template_x_account_status_failed" model="mail.template">
        <field name="name">X Account: Connection Failed</field>
        <field name="model_id" ref="social.model_social_account"/>
        <field name="subject">X account connection failed: {{ object.name }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px;">
                    <span>This X account connection is failing: a required X connection or Chat Encryption component stopped working, so its automation is suspended until it is fixed.</span>
                </p>
                <p style="margin: 8px 0px 0px 0px;">
                    <span>Account: <b t-out="object.name"/><br/>
                        Reason: <t t-out="object.last_error"/>
                    </span>
                </p>
            </div>
        </field>
    </record>

    <record id="mail_template_x_account_status_connected" model="mail.template">
        <field name="name">X Account: Connected</field>
        <field name="model_id" ref="social.model_social_account"/>
        <field name="subject">X account connected: {{ object.name }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px;">
                    <span>This X account is connected again: X authentication is valid and Chat Encryption is ready, so its automation can run.</span>
                </p>
                <p style="margin: 8px 0px 0px 0px;">
                    <span>Account: <b t-out="object.name"/></span>
                </p>
            </div>
        </field>
    </record>
</odoo>
