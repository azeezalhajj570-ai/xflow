<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Channel automation server actions.
            These are reusable server actions that can be triggered by
            manually configured Automation Rules in the Odoo UI.
            Each action delegates to the corresponding x.message method.
        -->

        <!-- Like Server Action -->
        <record id="ir_actions_server_x_message_like" model="ir.actions.server">
            <field name="name">X: Channel Like</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_like()
            </field>
        </record>

