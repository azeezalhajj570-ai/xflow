<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Channel automation server actions.
            These are reusable server actions that can be triggered by
            manually configured Automation Rules in the Odoo UI.
            Each action delegates to the corresponding x.message method.
        -->

        <!-- Like Server Action -->
        <record id="ir_actions_server_x_message_like" model="ir.actions.server">
            <field name="name">X: Channel Like</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_like()
            </field>
        </record>

        <!-- Repost Server Action -->
        <record id="ir_actions_server_x_message_repost" model="ir.actions.server">
            <field name="name">X: Channel Repost</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_repost()
            </field>
        </record>

        <!-- Comment Server Action -->
        <record id="ir_actions_server_x_message_comment" model="ir.actions.server">
            <field name="name">X: Channel Comment</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_comment()
            </field>
        </record>

        <!-- Follow Server Action -->
        <record id="ir_actions_server_x_message_follow" model="ir.actions.server">
            <field name="name">X: Channel Follow</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_follow()
            </field>
        </record>

        <!-- Bookmark Server Action -->
        <record id="ir_actions_server_x_message_bookmark" model="ir.actions.server">
            <field name="name">X: Channel Bookmark</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_bookmark()
            </field>
        </record>

        <!-- Unbookmark Server Action -->
        <record id="ir_actions_server_x_message_unbookmark" model="ir.actions.server">
            <field name="name">X: Channel Unbookmark</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_unbookmark()
            </field>
        </record>

        <!--
            Channel automation rules. These fire when an x.message is created
            and trigger the corresponding channel operation (bookmark/unbookmark).
            Follows the same pattern as the like/repost/comment rules.
        -->

        <!-- Bookmark Automation Rule -->
        <record id="base_automation_x_channel_bookmark" model="base.automation">
            <field name="name">X: Channel Bookmark</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="trigger">on_time_created</field>
            <field name="trg_date_range">1</field>
            <field name="trg_date_range_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_actions_server_x_channel_bookmark" model="ir.actions.server">
            <field name="name">X: Channel Bookmark</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_bookmark()
            </field>
            <field name="base_automation_id" ref="base_automation_x_channel_bookmark"/>
        </record>

        <!-- Unbookmark Automation Rule -->
        <record id="base_automation_x_channel_unbookmark" model="base.automation">
            <field name="name">X: Channel Unbookmark</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="trigger">on_time_created</field>
            <field name="trg_date_range">1</field>
            <field name="trg_date_range_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_actions_server_x_channel_unbookmark" model="ir.actions.server">
            <field name="name">X: Channel Unbookmark</field>
            <field name="model_id" ref="model_x_message"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record._run_channel_unbookmark()
            </field>
            <field name="base_automation_id" ref="base_automation_x_channel_unbookmark"/>
        </record>
    </data>
</odoo>
