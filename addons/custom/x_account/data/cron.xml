<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_validate_x_sessions" model="ir.cron">
            <field name="name">X: Validate Sessions</field>
            <field name="model_id" ref="model_social_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_validate_x_sessions()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>

    <!-- Task-queue worker shards. Each job drains the accounts whose id falls
         in its bucket (account_id % shards == shard), so several cron threads
         process disjoint accounts in parallel. Per-account semantics are
         unchanged: an account still runs one task at a time (single-flight),
         and claiming is atomic (per-account advisory lock + FOR UPDATE SKIP
         LOCKED). Requires max_cron_threads >= shards.

         Fresh work wakes these jobs immediately: ``x.account.task.create``
         inserts an ``ir.cron.trigger`` row for them and pg_notifies the
         scheduler thread (see account_task.py), so a new task is drained
         within seconds instead of on the next crontab tick. The 10s interval
         below is the backstop cadence that picks up backlog which piled up
         without a create (server downtime, retries falling due). Do not push
         it back to minutes: ``_reschedule_later`` computes the next run from
         ``interval_type``/``interval_number``, and ``seconds`` is added to
         ``ir.cron`` by models/ir_cron.py.

         These records are deliberately NOT noupdate: the shard code/count is
         part of the deployment contract and must follow module upgrades. The
         legacy ``cron_process_x_task_queue`` record predates this and was
         created noupdate, so its linked server action is rewired by
         migrations/19.0.1.4.0/post-migrate.py and its interval by
         migrations/19.0.1.16.0/post-migrate.py. -->
    <data>
        <record id="cron_process_x_task_queue" model="ir.cron">
            <field name="name">X: Process Task Queue (shard 0)</field>
            <field name="model_id" ref="model_x_account_task"/>
            <field name="state">code</field>
            <field name="code">model._process_queue(shard=0, shards=2, commit=True)</field>
            <field name="interval_number">10</field>
            <field name="interval_type">seconds</field>
            <field name="active">True</field>
        </record>

        <record id="cron_process_x_task_queue_1" model="ir.cron">
            <field name="name">X: Process Task Queue (shard 1)</field>
            <field name="model_id" ref="model_x_account_task"/>
            <field name="state">code</field>
            <field name="code">model._process_queue(shard=1, shards=2, commit=True)</field>
            <field name="interval_number">10</field>
            <field name="interval_type">seconds</field>
            <field name="active">True</field>
        </record>

        <record id="cron_daily_archive_flagged_accounts" model="ir.cron">
            <field name="name">X: Daily Auto-Archive Flagged Accounts</field>
            <field name="model_id" ref="model_social_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_archive_flagged_accounts()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
