            <field name="base_automation_id" ref="base_automation_x_task_send_group_dm"/>
        </record>

        <record id="base_automation_x_task_bookmark" model="base.automation">
            <field name="name">X: Run Bookmark Task</field>
            <field name="model_id" ref="model_x_account_task"/>
