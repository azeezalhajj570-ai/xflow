<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="action_server_fetch_group_messages" model="ir.actions.server">
            <field name="name">Fetch Group Messages</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="binding_model_id" ref="mail.model_discuss_channel"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">action = records.action_fetch_group_messages_bulk()</field>
        </record>

        <record id="action_server_fetch_group_members" model="ir.actions.server">
            <field name="name">Fetch Group Members</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="binding_model_id" ref="mail.model_discuss_channel"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">action = records.action_fetch_group_members_bulk()</field>
        </record>

        <record id="action_server_fetch_group_members_form" model="ir.actions.server">
            <field name="name">Fetch Group Members (current chat)</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="state">code</field>
            <field name="code">action = (records or record)[:1].action_fetch_group_members()</field>
        </record>

        <record id="action_server_bulk_follow" model="ir.actions.server">
            <field name="name">Follow Members</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="state">code</field>
            <field name="code">action = (records or record)[:1].action_bulk_follow()</field>
        </record>

        <record id="action_server_send_message" model="ir.actions.server">
            <field name="name">Send Message</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="state">code</field>
            <field name="code">action = (records or record)[:1].action_send_message()</field>
        </record>

        <record id="action_server_fetch_group_info" model="ir.actions.server">
            <field name="name">Fetch Group Info</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="binding_model_id" ref="mail.model_discuss_channel"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">action = records.action_fetch_group_info_bulk()</field>
        </record>

        <record id="action_server_groups_by_account" model="ir.actions.server">
            <field name="name">Groups by Account</field>
            <field name="model_id" ref="social.model_social_account"/>
            <field name="state">code</field>
            <field name="code">action = False
if records:
    action = records[:1].action_x_account_groups_by_account()</field>
        </record>

        <record id="action_server_cancel_duplicate_tasks" model="ir.actions.server">
            <field name="name">Cancel Duplicate Failed Tasks</field>
            <field name="model_id" ref="x_account.model_x_account_task"/>
            <field name="binding_model_id" ref="x_account.model_x_account_task"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">action = records.action_cancel_duplicate_tasks()</field>
        </record>

    </data>
</odoo>
