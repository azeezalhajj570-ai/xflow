<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="security_rule_x_message_company" model="ir.rule">
        <field name="name">X Message: Multi-Company</field>
        <field name="model_id" ref="model_x_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="security_rule_x_account_task_company" model="ir.rule">
        <field name="name">X Account Task: Multi-Company</field>
        <field name="model_id" ref="model_x_account_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="security_rule_discuss_channel_x_company" model="ir.rule">
        <field name="name">Discuss Channel (X): Multi-Company</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="domain_force">['|', ('x_company_id', '=', False), ('x_company_id', 'in', company_ids)]</field>
    </record>

</odoo>
