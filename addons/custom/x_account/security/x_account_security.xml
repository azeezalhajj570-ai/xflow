<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="res.groups.privilege" id="res_groups_privilege_x_account">
            <field name="name">X Account</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_x_account_user" model="res.groups">
            <field name="name">X Account User</field>
            <field name="privilege_id" ref="res_groups_privilege_x_account"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_x_account_manager" model="res.groups">
            <field name="name">X Account Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_x_account"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_x_account_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
