<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="action_migrate_automation_company" model="ir.actions.server">
            <field name="name">Migrate Automation Rules to Company</field>
            <field name="model_id" ref="base_automation.model_base_automation"/>
            <field name="state">code</field>
            <field name="code">
automations = env['base.automation'].search([('company_id', '=', False)])
for automation in automations:
    automation.write({'company_id': env.company.id})
            </field>
        </record>
    </data>
</odoo>
