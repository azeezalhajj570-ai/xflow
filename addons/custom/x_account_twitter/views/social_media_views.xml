<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Link Account page: same social.media kanban as Social Marketing >
         Configuration > Social Media, but showing only the X/Twitter card.
         The card's "Link account" button routes through social.media._action_add_account,
         which x_account_twitter overrides to start the OAuth 2.0 PKCE flow. -->
    <record id="x_account_twitter_social_media_view_kanban" model="ir.ui.view">
        <field name="name">x.account.twitter.social.media.view.kanban</field>
        <field name="model">social.media</field>
        <field name="arch" type="xml">
            <kanban create="false" can_open="0">
                <field name="can_link_accounts"/>
                <field name="accounts_count"/>
                <templates>
                    <t t-name="card" class="o_kanban_color_5">
                        <div class="d-flex flex-row">
                            <field name="image" widget="image" alt="Social Media" options="{'size': [64, 64]}"/>
                            <div class="mt-0 ms-2 d-flex flex-column">
                                <field name="name" class="fs-3 fw-bold mb-1"/>
                                <field name="media_description"/>
                            </div>
                        </div>
                        <button t-if="record.can_link_accounts.raw_value" type="object" class="btn btn-primary col-4 text-nowrap mt-2" name="action_add_account">Link account</button>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_x_account_twitter_link_account" model="ir.actions.act_window">
        <field name="name">Link X Account</field>
        <field name="res_model">social.media</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('media_type', '=', 'twitter')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('x_account_twitter_social_media_view_kanban')})]"/>
    </record>

    <!-- Repoint the x_account "Link Account" entry to the twitter kanban page. -->
    <menuitem id="x_account.menu_x_account_link_account"
              parent="x_account.menu_x_account_root"
              action="action_x_account_twitter_link_account"/>
</odoo>
