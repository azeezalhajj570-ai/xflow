<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_getxapi_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.x.account.getxapi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="x_account.x_account_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='x_account_settings_block']" position="inside">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <label for="x_getxapi_api_key" string="GetXAPI API Key"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <field name="x_getxapi_api_key" password="True"/>
                            <div class="text-muted">
                                GetXAPI API key (Authorization: Bearer). Used only by the
                                optional GetXAPI provider for paid per-call X/Twitter data access.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
