<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_getxapi_social_account_view_form" model="ir.ui.view">
        <field name="name">x.account.getxapi.social.account.view.form</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="x_account.x_account_social_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='x_account_api']" position="inside">
                <field name="x_provider" invisible="x_provider != 'getxapi'"/>
                <field name="authtoken" password="True"
                    invisible="x_action_provider != 'getxapi'"/>
                <field name="ct0" password="True"
                    invisible="x_action_provider != 'getxapi'"/>
                <field name="x_getxapi_credit_blocked"
                    invisible="not x_getxapi_credit_blocked"/>
                <field name="x_getxapi_credit_blocked_at"
                    invisible="not x_getxapi_credit_blocked"/>
                <field name="x_getxapi_credit_error"
                    invisible="not x_getxapi_credit_blocked"/>
                <button name="action_resume_getxapi_credit" type="object"
                    string="Resume GetXAPI" class="btn-primary"
                    invisible="not x_getxapi_credit_blocked"
                    groups="x_account.group_x_account_manager"/>
            </xpath>
        </field>
    </record>

    <record id="x_account_getxapi_social_account_view_form_standalone" model="ir.ui.view">
        <field name="name">x.account.getxapi.social.account.view.form.standalone</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="x_account.x_account_social_account_view_form_standalone"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='x_account_api']" position="inside">
                <field name="authtoken" password="True"
                    invisible="x_action_provider != 'getxapi'"/>
                <field name="ct0" password="True"
                    invisible="x_action_provider != 'getxapi'"/>
            </xpath>
        </field>
    </record>

    <record id="x_account_getxapi_import_session_view_form" model="ir.ui.view">
        <field name="name">x.account.getxapi.import.session.view.form</field>
        <field name="model">x.import.session</field>
        <field name="inherit_id" ref="x_account.x_import_session_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auth_token']" position="after">
                <field name="username" invisible="provider != 'getxapi'" required="provider == 'getxapi'"/>
            </xpath>
        </field>
    </record>
</odoo>
