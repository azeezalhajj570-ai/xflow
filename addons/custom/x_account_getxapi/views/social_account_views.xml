<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_getxapi_social_account_view_form" model="ir.ui.view">
        <field name="name">x.account.getxapi.social.account.view.form</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="x_account.x_account_social_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='x_account']" position="inside">
                <field name="x_provider" invisible="x_provider != 'getxapi'"/>
            </xpath>
        </field>
    </record>
</odoo>
