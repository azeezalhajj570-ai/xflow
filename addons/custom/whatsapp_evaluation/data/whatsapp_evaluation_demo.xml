<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="account_demo" model="whatsapp.account">
            <field name="name">Demo Account</field>
            <field name="base_url">https://api.example.com</field>
            <field name="instance_name">demo_instance</field>
            <field name="api_key">demo_key</field>
            <field name="notify_user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
        </record>

        <!-- Partner -->
        <record id="partner_demo_whatsapp_eval" model="res.partner">
            <field name="name">Demo WhatsApp User</field>
            <field name="phone">+967777777777</field>
            <field name="country_id" ref="base.ye"/>
        </record>

        <!-- Channel -->
        <record model="discuss.channel" id="demo_whatsapp_evaluation_channel">
            <field name="name">Demo WhatsApp User</field>
            <field name="channel_type">whatsapp</field>
            <field name="whatsapp_number">967777777777</field>
            <field name="whatsapp_partner_id" ref="partner_demo_whatsapp_eval"/>
            <field name="channel_partner_ids" eval="[Command.link(ref('partner_demo_whatsapp_eval')), Command.link(ref('base.partner_root'))]"/>
            <field name="wa_account_id" ref="account_demo"/>
        </record>

        <!-- Message -->
        <record model="mail.message" id="demo_message_1">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="demo_whatsapp_evaluation_channel"/>
            <field name="message_type">whatsapp_message</field>
            <field name="author_id" ref="partner_demo_whatsapp_eval"/>
            <field name="body">Hello! This is a demo message for the Evaluation API.</field>
            <field name="date">2026-01-01 10:00:00</field>
        </record>
    </data>
</odoo>
