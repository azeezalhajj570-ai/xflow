<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="social_post_template_view_form" model="ir.ui.view">
        <field name="name">social.post.template.view.form.inherit.tiktok</field>
        <field name="model">social.post.template</field>
        <field name="priority">5</field>
        <field name="inherit_id" ref="social.social_post_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_ids']" position="after">
                <field name="has_tiktok_account" invisible="1"/>
            </xpath>
        </field>
    </record>
</data>
</odoo>
