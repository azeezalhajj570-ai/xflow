<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The stock Feed is kanban-only with a custom JS renderer, so this
         module ships its own list/form to expose the fetched posts and their
         interaction drill-down. -->
    <record id="x_social_stream_post_view_list" model="ir.ui.view">
        <field name="name">x.social.stream.post.view.list</field>
        <field name="model">social.stream.post</field>
        <field name="arch" type="xml">
            <list string="X Posts" create="false" edit="false">
                <field name="published_date"/>
                <field name="author_name"/>
                <field name="message"/>
                <field name="x_favorite_count" string="Likes"/>
                <field name="x_retweet_count" string="Retweets"/>
                <field name="x_reply_count" string="Replies"/>
                <field name="x_comment_count" string="Comments stored"/>
                <field name="x_author_x_username" optional="hide"/>
                <field name="stream_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="x_social_stream_post_view_form" model="ir.ui.view">
        <field name="name">x.social.stream.post.view.form</field>
        <field name="model">social.stream.post</field>
        <field name="arch" type="xml">
            <form string="X Post" create="false" edit="false">
                <header>
                    <button name="action_refresh_x_interactions" type="object"
                        string="Refresh Interactions" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="author_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="stream_id" readonly="1"/>
                            <field name="published_date" readonly="1"/>
                            <field name="x_tweet_id" readonly="1"/>
                            <field name="x_source_provider" readonly="1"/>
                            <field name="post_link" widget="url" readonly="1"/>
                            <field name="x_interactions_fetched_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="x_favorite_count" readonly="1"/>
                            <field name="x_retweet_count" readonly="1"/>
                            <field name="x_reply_count" readonly="1"/>
                            <field name="x_quote_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message" name="x_message">
                            <field name="message" readonly="1"/>
                        </page>
                        <page string="Comments" name="x_comments">
                            <field name="x_interaction_ids" readonly="1"
                                domain="[('kind', '=', 'comment')]">
                                <list create="false" delete="false">
                                    <field name="author_name"/>
                                    <field name="author_x_username"/>
                                    <field name="text"/>
                                    <field name="like_count"/>
                                    <field name="external_created_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Retweets" name="x_retweets">
                            <field name="x_interaction_ids" readonly="1"
                                domain="[('kind', '=', 'retweet')]">
                                <list create="false" delete="false">
                                    <field name="author_name"/>
                                    <field name="author_x_username"/>
                                    <field name="author_partner_id"/>
                                    <field name="external_created_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Likes" name="x_likes">
                            <field name="x_interaction_ids" readonly="1"
                                domain="[('kind', '=', 'like')]">
                                <list create="false" delete="false">
                                    <field name="author_name"/>
                                    <field name="author_x_username"/>
                                    <field name="author_partner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="x_social_stream_post_view_search" model="ir.ui.view">
        <field name="name">x.social.stream.post.view.search</field>
        <field name="model">social.stream.post</field>
        <field name="arch" type="xml">
            <search string="X Posts">
                <field name="message"/>
                <field name="author_name"/>
                <field name="x_author_x_username"/>
                <filter name="x_with_comments" string="With comments stored"
                    domain="[('x_comment_count', '&gt;', 0)]"/>
                <group>
                    <filter name="group_by_stream" string="Stream"
                        context="{'group_by': 'stream_id'}"/>
                    <filter name="group_by_provider" string="Provider"
                        context="{'group_by': 'x_source_provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Extend the Social Marketing feed kanban (the same view every provider
         inherits) so X posts show their stats inside the standard feed card,
         instead of defining a separate kanban. -->
    <record id="social_stream_post_view_kanban" model="ir.ui.view">
        <field name="name">social.stream.post.view.kanban.inherit.x_account_social_posts</field>
        <field name="model">social.stream.post</field>
        <field name="inherit_id" ref="social.social_stream_post_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stream_post_image_urls']" position="after">
                <field name="x_source_provider"/>
                <field name="x_tweet_id"/>
                <field name="x_favorite_count"/>
                <field name="x_retweet_count"/>
                <field name="x_reply_count"/>
                <field name="x_comment_count"/>
            </xpath>
            <xpath expr="//div[hasclass('o_social_stream_post_message')]" position="inside">
                <div class="o_social_stream_post_x_stats d-flex justify-content-around px-2 pb-2"
                    t-if="record.x_source_provider.raw_value">
                    <div class="o_social_subtle_btn_disabled ps-2">
                        <i class="fa fa-heart me-1" title="Likes"/>
                        <field name="x_favorite_count" class="fw-bold"/>
                    </div>
                    <div class="o_social_subtle_btn_disabled">
                        <i class="fa fa-retweet me-1" title="Retweets"/>
                        <field name="x_retweet_count" class="fw-bold"/>
                    </div>
                    <div class="o_social_subtle_btn_disabled">
                        <i class="fa fa-comment me-1" title="Replies"/>
                        <field name="x_reply_count" class="fw-bold"/>
                    </div>
                    <div class="o_social_subtle_btn_disabled pe-2">
                        <i class="fa fa-comments me-1" title="Comments stored"/>
                        <field name="x_comment_count" class="fw-bold"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- The X Posts action uses its own kanban on purpose: it does NOT carry
         the feed's js_class (`social_stream_post_kanban_view`), whose load runs
         social.stream.refresh_all() and would fire automatic X API calls (402
         Payment Required once credits are depleted). This view only renders
         what is already stored; fetching is done from the wizard. -->
    <record id="x_social_stream_post_view_kanban" model="ir.ui.view">
        <field name="name">x.social.stream.post.view.kanban</field>
        <field name="model">social.stream.post</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" quick_create="false">
                <field name="author_name"/>
                <field name="published_date"/>
                <field name="message"/>
                <field name="post_link"/>
                <field name="x_tweet_id"/>
                <field name="x_source_provider"/>
                <field name="x_favorite_count"/>
                <field name="x_retweet_count"/>
                <field name="x_reply_count"/>
                <field name="x_comment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong class="text-truncate">
                                <field name="author_name"/>
                            </strong>
                            <span class="text-muted small ms-2">
                                <field name="published_date" widget="datetime"/>
                            </span>
                        </div>
                        <div class="mb-2">
                            <field name="message"/>
                        </div>
                        <div class="d-flex gap-3 text-muted small"
                            t-if="record.x_source_provider.raw_value">
                            <span title="Likes">
                                <i class="fa fa-heart me-1"/><field name="x_favorite_count"/>
                            </span>
                            <span title="Retweets">
                                <i class="fa fa-retweet me-1"/><field name="x_retweet_count"/>
                            </span>
                            <span title="Replies">
                                <i class="fa fa-comment me-1"/><field name="x_reply_count"/>
                            </span>
                            <span title="Comments stored">
                                <i class="fa fa-comments me-1"/><field name="x_comment_count"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_x_social_stream_posts" model="ir.actions.act_window">
        <field name="name">X Posts</field>
        <field name="res_model">social.stream.post</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('media_type', '=', 'twitter')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('x_social_stream_post_view_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('x_social_stream_post_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('x_social_stream_post_view_form')})]"/>
    </record>

    <menuitem id="menu_x_social_stream_posts" parent="social.menu_social_global"
        action="action_x_social_stream_posts" sequence="15" name="X Posts"/>
</odoo>
