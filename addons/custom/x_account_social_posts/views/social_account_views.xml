<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standard social account form (Social Marketing > Configuration >
         Social Accounts). The fetch/post entries are always shown. -->
    <record id="x_account_social_posts_social_account_view_form" model="ir.ui.view">
        <field name="name">x.account.social.posts.social.account.view.form</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="social.social_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image']" position="after">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_x_posts" type="object"
                        class="oe_stat_button" icon="fa-comments">
                        <field name="x_social_stream_post_count" widget="statinfo"
                            string="X Posts"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_fetch_x_posts" type="object"
                    string="Fetch X Posts" class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <!-- Standalone "X Account" form (the X Accounts menu). -->
    <record id="x_account_social_posts_social_account_view_form_standalone" model="ir.ui.view">
        <field name="name">x.account.social.posts.social.account.view.form.standalone</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="x_account.x_account_social_account_view_form_standalone"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_fetch_x_posts" type="object"
                    string="Fetch X Posts" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
