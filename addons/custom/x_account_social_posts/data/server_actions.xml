<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Fetch X Posts" as a server action bound to social.account, like the
         other account-form actions in x_account/data/server_actions_form.xml,
         instead of a button hand-placed in each form view. The binding makes
         it available on every social.account form, so the view no longer
         carries its own button. -->
    <data>
        <record id="action_form_fetch_x_posts" model="ir.actions.server">
            <field name="name">Fetch X Posts</field>
            <field name="model_id" ref="social.model_social_account"/>
            <field name="binding_model_id" ref="social.model_social_account"/>
            <field name="binding_type">action</field>
            <field name="binding_view_types">form</field>
            <field name="group_ids" eval="[(6, 0, [ref('social.group_social_user')])]"/>
            <field name="sequence">50</field>
            <field name="state">code</field>
            <field name="code">action = (records or record)[:1].action_fetch_x_posts()</field>
        </record>
    </data>
</odoo>
