<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="action_server_register_webhook" model="ir.actions.server">
            <field name="name">Register Webhook</field>
            <field name="model_id" ref="social.model_social_account"/>
            <field name="binding_model_id" ref="social.model_social_account"/>
            <field name="state">code</field>
            <field name="code">action = False
for rec in records:
    action = rec.with_context(dialog=True).action_register_webhook()</field>
        </record>

        <record id="action_server_validate_webhook" model="ir.actions.server">
            <field name="name">Validate Webhook</field>
            <field name="model_id" ref="social.model_social_account"/>
            <field name="binding_model_id" ref="social.model_social_account"/>
            <field name="state">code</field>
            <field name="code">action = False
for rec in records:
    action = rec.with_context(dialog=True).action_validate_webhook()</field>
        </record>

        <record id="action_server_delete_webhook" model="ir.actions.server">
            <field name="name">Delete Webhook</field>
            <field name="model_id" ref="social.model_social_account"/>
            <field name="binding_model_id" ref="social.model_social_account"/>
            <field name="state">code</field>
            <field name="code">action = False
for rec in records:
    action = rec.with_context(dialog=True).action_delete_webhook()</field>
        </record>
    </data>
</odoo>
