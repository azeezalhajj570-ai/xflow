<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_omnix_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.x.account.omnix</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="x_account.x_account_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='x_account']" position="inside">
                <block title="OmniX Provider">
                    <setting string="OmniX API Key" help="OmniX API key (Authorization: Bearer). Used only by the optional OmniX provider.">
                        <field name="x_omnix_api_key" password="True"/>
                    </setting>
                    <setting string="Webhook Base URL" help="Public https base URL of this Odoo instance. OmniX webhooks are registered at &lt;base&gt;/x_account/webhook/&lt;account&gt;.">
                        <field name="x_webhook_base_url" placeholder="https://azeez-tech.com"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
