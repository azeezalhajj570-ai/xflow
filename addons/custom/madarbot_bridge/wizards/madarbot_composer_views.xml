<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="madarbot_telegram_composer_view_form" model="ir.ui.view">
        <field name="name">madarbot.telegram.composer.form</field>
        <field name="model">madarbot.telegram.composer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="body" required="1"/>
                    <field name="account_id" required="1"/>
                </group>
                <group>
                    <field name="channel_ids" widget="many2many_tags"/>
                    <field name="guest_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="_action_send" type="object" string="Send"
                        class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</data></odoo>
