<odoo>
    <record id="res_config_settings_view_form_iap_provider_social_relay" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.iap.provider.social.relay</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="IAP Social Relay" name="iap_provider_social_relay" groups="base.group_system">
                    <block title="Provider Settings">
                        <setting string="Relay Endpoint" help="Base URL of your relay service.">
                            <field name="iap_provider_social_relay_endpoint" placeholder="https://relay.example.com"/>
                        </setting>
                        <setting string="Default Service" help="Optional technical_name to auto-select service for Social Relay provider.">
                            <field name="iap_provider_social_relay_default_service" placeholder="reveal"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
