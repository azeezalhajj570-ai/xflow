<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="x_account_xactions_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.x.account.xactions</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="x_account.x_account_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='x_account']" position="inside">
                <block title="XActions API Provider">
                    <setting string="Base URL">
                        <field name="x_xactions_base_url"
                            placeholder="https://xactions.azeez-tech.com"/>
                    </setting>
                    <setting string="Token" help="Bearer JWT. Leave empty to log in with the identifier and password.">
                        <field name="x_xactions_token" password="True"/>
                    </setting>
                    <setting string="Identifier">
                        <field name="x_xactions_identifier"/>
                    </setting>
                    <setting string="Password">
                        <field name="x_xactions_password" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
